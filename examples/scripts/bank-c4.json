[
  {"cmd": "model.tree", "params": {}, "as": "new"},
  {"cmd": "element.delete", "params": {"ids": ["$new.tree.children.0.children.0.id"]}},
  {"cmd": "diagram.add", "params": {"type": "C4 Diagram", "name": "System Context", "parent": "$new.tree.id"}, "as": "context"},
  {"cmd": "element.set", "params": {"id": "$context.id", "values": {"defaultDiagram": true}}},

  {"cmd": "node.create", "params": {"kind": "Person", "x": 300, "y": 20, "name": "Personal Banking Customer"}, "as": "customer"},
  {"cmd": "element.set", "params": {"id": "$customer.model", "values": {"description": "A customer of the bank, with personal bank accounts."}}},
  {"cmd": "node.create", "params": {"kind": "Software System", "x": 280, "y": 260, "name": "Internet Banking System"}, "as": "bank"},
  {"cmd": "element.set", "params": {"id": "$bank.model", "values": {"description": "Lets customers see their accounts and make payments."}}},
  {"cmd": "view.resize", "params": {"view": "$bank.view", "width": 200, "height": 110}},
  {"cmd": "node.create", "params": {"kind": "Software System", "x": 20, "y": 460, "name": "Mainframe Banking System"}, "as": "mainframe"},
  {"cmd": "element.set", "params": {"id": "$mainframe.model", "values": {"description": "Stores customers, accounts and transactions."}}},
  {"cmd": "view.resize", "params": {"view": "$mainframe.view", "width": 200, "height": 110}},
  {"cmd": "node.create", "params": {"kind": "Software System", "x": 540, "y": 460, "name": "E-mail System"}, "as": "email"},
  {"cmd": "element.set", "params": {"id": "$email.model", "values": {"description": "The bank's Microsoft Exchange e-mail system."}}},
  {"cmd": "view.resize", "params": {"view": "$email.view", "width": 200, "height": 110}},

  {"cmd": "edge.create", "params": {"kind": "Relationship", "tail": "$customer.view", "head": "$bank.view"}, "as": "r1"},
  {"cmd": "element.set", "params": {"id": "$r1.model", "values": {"description": "Views accounts, makes payments"}}},
  {"cmd": "edge.create", "params": {"kind": "Relationship", "tail": "$bank.view", "head": "$mainframe.view"}, "as": "r2"},
  {"cmd": "element.set", "params": {"id": "$r2.model", "values": {"description": "Gets account information", "technology": "XML/HTTPS"}}},
  {"cmd": "edge.create", "params": {"kind": "Relationship", "tail": "$bank.view", "head": "$email.view"}, "as": "r3"},
  {"cmd": "element.set", "params": {"id": "$r3.model", "values": {"description": "Sends e-mail using", "technology": "SMTP"}}},

  {"cmd": "diagram.add", "params": {"type": "C4 Diagram", "name": "Containers", "parent": "$bank.model"}, "as": "inside"},
  {"cmd": "view.add", "params": {"model": "$bank.model", "x": 20, "y": 20}, "as": "boundary"},
  {"cmd": "view.resize", "params": {"view": "$boundary.view", "width": 760, "height": 300}},
  {"cmd": "node.create", "params": {"kind": "Container (Web App)", "x": 50, "y": 50, "name": "Single-Page App"}, "as": "spa"},
  {"cmd": "element.set", "params": {"id": "$spa.model", "values": {"technology": "TypeScript", "description": "Banking in the browser."}}},
  {"cmd": "node.create", "params": {"kind": "Container (Mobile App)", "x": 300, "y": 50, "name": "Mobile App"}, "as": "mobile"},
  {"cmd": "element.set", "params": {"id": "$mobile.model", "values": {"technology": "Kotlin", "description": "Banking on a phone."}}},
  {"cmd": "node.create", "params": {"kind": "Container", "x": 300, "y": 190, "name": "API Application"}, "as": "api"},
  {"cmd": "element.set", "params": {"id": "$api.model", "values": {"technology": "Rust", "description": "Serves banking over JSON/HTTPS.", "kind": "server-webapp"}}},
  {"cmd": "node.create", "params": {"kind": "Container (Database)", "x": 560, "y": 170, "name": "Database"}, "as": "db"},
  {"cmd": "element.set", "params": {"id": "$db.model", "values": {"technology": "PostgreSQL", "description": "Accounts and audit logs."}}},
  {"cmd": "view.resize", "params": {"view": "$db.view", "width": 180, "height": 130}},
  {"cmd": "edge.create", "params": {"kind": "Relationship", "tail": "$spa.view", "head": "$api.view"}, "as": "c1"},
  {"cmd": "element.set", "params": {"id": "$c1.model", "values": {"description": "Calls", "technology": "JSON/HTTPS"}}},
  {"cmd": "edge.create", "params": {"kind": "Relationship", "tail": "$mobile.view", "head": "$api.view"}, "as": "c2"},
  {"cmd": "element.set", "params": {"id": "$c2.model", "values": {"description": "Calls"}}},
  {"cmd": "edge.create", "params": {"kind": "Relationship", "tail": "$api.view", "head": "$db.view"}, "as": "c3"},
  {"cmd": "element.set", "params": {"id": "$c3.model", "values": {"description": "Reads and writes", "technology": "SQL"}}}
]
